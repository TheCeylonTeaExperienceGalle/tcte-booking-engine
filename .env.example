# Local environment template. Copy to .env.local — never commit real values.
# JWT secrets must be at least 32 characters.

DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/tcte_local"

JWT_ACCESS_SECRET="replace_me_with_at_least_32_characters"
JWT_REFRESH_SECRET="replace_me_with_at_least_32_characters"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

PAYHERE_MERCHANT_ID="replace_me"
PAYHERE_MERCHANT_SECRET="replace_me"
PAYHERE_RETURN_URL="https://example.invalid/book/result"
PAYHERE_CANCEL_URL="https://example.invalid/book/result"
PAYHERE_NOTIFY_URL="https://example.invalid/api/public/payhere/notify"
PAYHERE_CHECKOUT_URL="https://sandbox.payhere.lk/pay/checkout"

BOOKINGS_REPORT_API_KEY="replace_me"

# Set true only when this process sits behind a trusted reverse proxy.
TRUST_PROXY="false"

# Production seed is refused unless this is explicitly true.
ALLOW_SEED="false"

# Optional. Pending-booking seat expiry is not enabled until TCTE chooses a policy.
# PAYMENT_PENDING_EXPIRY_MINUTES=
